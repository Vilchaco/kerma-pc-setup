@OBSThemeMeta {
    name: 'Kerma';
    id: 'com.kerma.Yami.Kerma';
    extends: 'com.obsproject.Yami';
    author: 'Kerma Games';
    dark: 'true';
}

/*
  Kerma Games look for OBS (Kerma Games Brandbook 2026 palette).
  A variant of OBS's default theme (Yami): only the colors change, the
  layout stays the stock one, so it keeps working across OBS updates.
  If OBS cannot load it, it simply falls back to its default theme.
*/

@OBSThemeVars {
    /* Brandbook backgrounds: --bg #0A0712, surfaces #110C1F / #161029, borders #353041, greys #4D4957 / #56525F */
    --grey1: #56525F;
    --grey2: #4D4957;
    --grey3: #403A4F;
    --grey4: #353041;
    --grey5: #241D35;
    --grey6: #161029;
    --grey7: #110C1F;
    --grey8: #0A0712;

    /* Kerma orange (#EA7F2B, Pantone 158 C). Selected rows/tabs carry light text, so
       they use the darker brand oranges; the real orange is kept for borders and highlights. */
    --primary: #BA6622;
    --primary_light: #D2742A;
    --primary_lighter: #EA7F2B;
    --primary_dark: #96521C;
    --primary_darker: #764016;

    --text: #FFFFFF;
    --text_light: #ffffff;
    --text_muted: #CFCED2;

    --border_color: var(--grey5);

    --input_bg: var(--grey5);
    --input_bg_hover: var(--grey7);
    --input_bg_focus: var(--grey7);
    --input_border: var(--grey3);
    --input_border_hover: var(--grey1);
    --input_border_focus: var(--primary_lighter);

    --button_bg: var(--grey4);
    --button_bg_hover: var(--grey3);
    --button_border: var(--grey4);
    --button_border_hover: var(--primary_lighter);
    --button_border_focus: var(--primary_lighter);

    --tab_border_hover: var(--primary_light);
    --tab_border_focus: var(--primary_lighter);

    --scrollbar_handle: var(--grey4);
    --scrollbar_hover: var(--primary_dark);
    --scrollbar_down: var(--primary);
    --scrollbar_border: var(--grey5);
}

QDockWidget::title {
    background-color: var(--grey6);
}

OBSQTDisplay {
    qproperty-displayBackgroundColor: var(--grey8);
}

idian--ToggleSwitch {
    qproperty-background_checked: var(--primary);
    qproperty-background_checked_hover: var(--primary_light);
}
